@model WebFrontEnd.Models.Product

@{
    ViewBag.Title = "Create Product";
}

<div class="container mt-5">
    <h2 class="text-primary mb-4">Create Product</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="card shadow-sm p-4">
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-3">
                @Html.LabelFor(model => model.ProductsName, htmlAttributes: new { @class = "form-label" })
                @Html.EditorFor(model => model.ProductsName, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter product name" } })
                @Html.ValidationMessageFor(model => model.ProductsName, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.ProductsPrices, htmlAttributes: new { @class = "form-label" })
                @Html.EditorFor(model => model.ProductsPrices, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter price" } })
                @Html.ValidationMessageFor(model => model.ProductsPrices, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.quantity, htmlAttributes: new { @class = "form-label" })
                @Html.EditorFor(model => model.quantity, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter stock quantity" } })
                @Html.ValidationMessageFor(model => model.quantity, "", new { @class = "text-danger" })
            </div>

            <div class="d-flex justify-content-between">
                <input type="submit" value="💾 Save" class="btn btn-success" />
                @Html.ActionLink("⬅️ Back to List", "Index", null, new { @class = "btn btn-outline-secondary" })
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
