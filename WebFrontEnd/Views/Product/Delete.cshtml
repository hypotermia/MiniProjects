@model WebFrontEnd.Models.Product

@{
    ViewBag.Title = "Delete Product";
}

<div class="container mt-5">
    <h2 class="text-danger mb-4">Delete Product</h2>

    <div class="card shadow-sm p-4 mb-4">
        <h4 class="text-secondary">Are you sure you want to delete this?</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ProductsName)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ProductsName)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ProductsPrices)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ProductsPrices)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.quantity)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.quantity)</dd>
        </dl>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="d-flex justify-content-between">
            <input type="submit" value="🗑️ Delete" class="btn btn-danger" />
            @Html.ActionLink("⬅️ Back to List", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div>
