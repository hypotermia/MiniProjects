@model IEnumerable<WebFrontEnd.Models.DetailTransaction>

@{
    ViewBag.Title = "Transaction Index";
}


    <h2 class="mb-4">📋 Transaction List</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <table class="table table-bordered table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Transaction ID</th>
                <th>Product Name</th>
                <th>Quantity</th>
                <th>Total Per Transaction</th>
                <th>Created Date</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in Model)
            {
                <tr>
                    <td>@transaction.Id</td>
                    <td>@transaction.ProductsName</td>
                    <td>@transaction.Quantity</td>
                    <td>@transaction.TotalPerTrx</td>
                    <td>@transaction.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                    <td class="text-center">
                        <a href="@Url.Action("Details", "Transaction", new { uId = transaction.Id })" class="btn btn-sm btn-info me-2">Details</a>
                        <a href="@Url.Action("Delete", "Transaction", new { uId = transaction.Id })"
                           class="btn btn-sm btn-danger"
                           onclick="return confirm('Are you sure you want to delete this transaction?');">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a href="@Url.Action("Create", "Transaction")" class="btn btn-primary mt-3">➕ Create New Transaction</a>
