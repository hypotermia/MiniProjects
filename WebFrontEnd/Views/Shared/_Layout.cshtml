@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    bool isLoggedIn = HttpContextAccessor.HttpContext.Session.GetString("IsLoggedIn") == "true";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebFrontEnd</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebFrontEnd.styles.css" asp-append-version="true" />
    <style>
        body {
            background-image: url('/images/coffe-cam.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            min-height: 100vh;
            margin: 0;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background-color: rgba(255, 255, 255, 0.9);
            padding-top: 20px;
            position: fixed;
            left: 0;
            top: 0;
            border-right: 1px solid #ddd;
        }

            .sidebar a {
                display: block;
                padding: 10px 20px;
                color: #333;
                text-decoration: none;
            }

                .sidebar a:hover {
                    background-color: #007bff;
                    color: white;
                }

        .content {
            margin-left: 250px;
            padding: 20px;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <h4 class="text-center">WebFrontEnd</h4>
        <a asp-controller="Home" asp-action="Index">Home</a>
        <a asp-controller="Home" asp-action="Privacy">Privacy</a>

        @if (isLoggedIn)
        {
            <a asp-controller="Product" asp-action="Index">Products</a>
            <a asp-controller="Transaction" asp-action="Index">Transaction</a>
            <div class="dropdown">
                <a class="dropdown-toggle" href="#" data-bs-toggle="dropdown">Report</a>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" asp-controller="Report" asp-action="DailyReport">Daily Report</a></li>
                    <li><a class="dropdown-item" asp-controller="Report" asp-action="MonthlyReport">Monthly Report</a></li>
                    <li><a class="dropdown-item" asp-controller="Report" asp-action="YearlyReport">Yearly Report</a></li>
                </ul>
            </div>
        }

        <hr />

        @if (!isLoggedIn)
        {
            <a asp-controller="Home" asp-action="Login">Login</a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Logout">Logout</a>
        }
    </div>

    <div class="content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

        <footer class="border-top footer text-muted mt-5">
            <div class="container">
                &copy; 2024 - WebFrontEnd - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
