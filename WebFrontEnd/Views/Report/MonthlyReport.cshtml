@model IEnumerable<WebFrontEnd.Models.MonthlyReport>

<h2>DailyReport</h2>

<table class="table table-bordered table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>ProductName</th>
            <th>Total Income</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductsName</td>
                <td>@item.TotalMonthly</td>


            </tr>
        }
    </tbody>
</table>


